---
import Layout from './Layout.astro';

interface Props {
  title: string;
  current?: string;
}

const { title, current = '' } = Astro.props;

const nav = [
  { label: 'トップ', href: '/contents/nilec/portal' },
  { label: '理念・組織', href: '/contents/nilec/rinen' },
  { label: '内部記録検索', href: '/contents/nilec/records' },
];
---

<Layout title={`${title} | NILEC 内部システム`}>
  <div class="np">

    <div class="np-security">
      NILEC 職員情報システム
      <span>職員専用 / INTERNAL USE ONLY</span>
    </div>

    <header class="np-head">
      <div class="np-head-inner">
        <div>
          <div class="np-mark">NILEC</div>
          <div class="np-title">
            国立研究開発法人 日本生命生態保全機構
          </div>
        </div>

        <div class="np-session">
          SESSION<br />
          <strong>monobe19750408</strong>
        </div>
      </div>
    </header>

    <nav class="np-nav">
      <div class="np-nav-inner">
        {nav.map((n) => (
          <a
            href={n.href}
            class={current === n.label ? 'current' : ''}
          >
            {n.label}
          </a>
        ))}

      </div>
    </nav>

    <main class="np-main">
      <div class="np-breadcrumb">
        NILEC 内部システム　&gt;　{title}
      </div>

      <slot />
    </main>

    <footer class="np-footer">
      <p>NATIONAL INSTITUTE FOR LIFE AND ECOLOGICAL CONSERVATION</p>
      <p>職員情報システム　/　内部利用専用</p>
      <p>このWebサイトの内容はすべてフィクションであり、実在の人物・団体とは一切関係ありません。</p>
    </footer>

  </div>
</Layout>

<style is:global>
  .np {
    --navy: #203844;
    --navy-dark: #152a33;
    --wine: #7b2638;
    --wine-dark: #5d1c2b;
    --wine-light: #f5edef;
    --line: #d8dfe1;
    --text: #333b3e;
    --muted: #69767b;

    min-height: 100vh;
    background: #fff;
    color: var(--text);

    font-family:
      "Yu Gothic",
      "Hiragino Kaku Gothic ProN",
      Meiryo,
      sans-serif;

    font-size: 14px;
    line-height: 1.8;

    display: flex;
    flex-direction: column;
  }

  /* 上部 */

  .np-security {
    background: var(--navy-dark);
    color: #dce3e6;
    font-size: 11px;
    padding: 6px 24px;
    text-align: center;
    letter-spacing: .04em;
  }

  .np-security span {
    margin-left: 18px;
    color: #aebbc0;
  }

  /* ヘッダー */

  .np-head {
    border-bottom: 4px solid var(--wine);
    background: #fff;
  }

  .np-head-inner {
    width: min(1100px, calc(100% - 64px));
    min-height: 86px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .np-mark {
    color: var(--wine);
    font-family: Georgia, serif;
    font-size: 25px;
    font-weight: bold;
    letter-spacing: .12em;
    line-height: 1;
  }

  .np-title {
    margin-top: 6px;
    color: var(--navy);
    font-size: 13px;
    letter-spacing: .04em;
  }

  .np-session {
    color: #899397;
    font-family: monospace;
    font-size: 10px;
    text-align: right;
    line-height: 1.5;
  }

  .np-session strong {
    color: var(--navy);
    font-weight: normal;
  }

  /* ナビ */

  .np-nav {
    background: var(--navy);
    border-bottom: 1px solid #10252d;
  }

  .np-nav-inner {
    width: min(1100px, calc(100% - 64px));
    margin: 0 auto;

    display: flex;
  }

  .np-nav a {
    display: block;

    padding: 9px 23px;

    color: #dce4e7;
    border-right: 1px solid rgba(255,255,255,.1);

    text-decoration: none;
    font-size: 12px;
  }

  .np-nav a:hover {
    background: #2d4b57;
  }

  .np-nav a.current {
    background: var(--wine);
    color: #fff;
    font-weight: bold;
  }

  .np-nav .np-public {
    margin-left: auto;
    color: #bfc9cd;
  }

  /* メイン */

  .np-main {
    width: min(1100px, calc(100% - 64px));
    margin: 0 auto;
    padding: 24px 0 60px;

    flex: 1;
  }

  .np-breadcrumb {
    margin-bottom: 28px;
    color: #899397;
    font-size: 11px;
  }

  /* セクション */

  .np-section {
    margin-bottom: 36px;
  }

  .np-section h2 {
    margin: 0 0 16px;

    padding: 0 0 8px;

    color: var(--navy);
    border-bottom: 2px solid var(--navy);

    font-size: 18px;
    letter-spacing: .03em;
  }

  .np-section h2::before {
    content: "■";
    color: var(--wine);
    font-size: 10px;
    margin-right: 8px;
    vertical-align: 2px;
  }

  /* ボックス */

  .np-box {
    background: #fff;
    border: 1px solid var(--line);
    padding: 20px 24px;
    margin-bottom: 16px;
  }

  .np-box-title {
    margin: 0 0 8px;
    color: var(--wine);
    font-size: 14px;
    font-weight: bold;
  }

  /* リンク */

  .np-link {
    color: var(--wine);
    font-weight: bold;
    text-decoration: none;
  }

  .np-link:hover {
    text-decoration: underline;
  }

  .np-link-note {
    color: var(--muted);
    font-size: 12px;
  }

  /* フッター */

  .np-footer {
    padding: 22px;
    background: #eef1f2;
    border-top: 1px solid var(--line);

    text-align: center;
    color: #7b8589;
    font-size: 10px;
  }

  .np-footer p {
    margin: 2px 0;
  }

  .np-footer p:first-child {
    color: var(--navy);
    font-weight: bold;
    letter-spacing: .08em;
  }

  @media (max-width: 700px) {
    .np-head-inner,
    .np-nav-inner,
    .np-main {
      width: calc(100% - 32px);
    }

    .np-session {
      display: none;
    }

    .np-nav-inner {
      overflow-x: auto;
    }

    .np-nav a {
      white-space: nowrap;
      padding: 9px 15px;
    }
  }
</style>