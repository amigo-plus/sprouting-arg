---
import Layout from '../layouts/Layout.astro';

const pages = [
  {
    page: '3ページ',
    hints: [
      '送られてきた画像を調べてみましょう。文中に何か、見慣れない単語がありませんか？',
      'このワードは土地の名前みたいです。',
    ],
    answer: '検索「真蔓」',
  },
  {
    page: '4ページ',
    hints: [
      '3ページを読み進めてみましょう。',
      '未だにリンクが作られていない地域があるようです。',
    ],
    answer: '検索「哥間村」',
  },
  {
    page: '12ページ',
    hints: [
      'ブログ内に何か気になる単語が出てきませんでしたか？',
      '10ページを確認してみましょう。',
    ],
    answer: '検索「還種」',
  },
  {
    page: '13ページ',
    hints: [
      'ブログの内容、そして12ページから導き出せそうです。',
      '10ジロー の本名を推理してみましょう。ブログのコメント欄は確認しましたか？',
    ],
    answer: '検索「深見天次郎」',
  },
  {
    page: '14ページ',
    hints: [
      '13ページを読み進めてみましょう。',
      'とある人の名前が新しく出てきましたよね。',
    ],
    answer: '検索「物部庄太」',
  },
  {
    page: '16ページ',
    hints: [
      '15ページは見ましたか？',
      'この研究室はどこかの機関と提携しているようです。',
    ],
    answer: '検索「日本生命生態保全機構」',
  },
  {
    page: '18ページ',
    hints: [
      '職員としてログインしてみたいところ。パスワードは再発行できるようですね。',
      'IDを入力しなければいけないようです。機構に関わりがありそうな人の情報が15ページにありましたよね？',
    ],
    answer: 'ID:「monobe19750408」、pass:「xk4p9qwe」を入力',
  },
  {
    page: '24・26ページ',
    hints: [
      '履歴として見られる3つの資料の中に、今回の事件を担当している班が記されていますね。',
      '23ページを確認してみてください。検索は内部記録検索で行ってくださいね。',
    ],
    answer: '内部記録検索「検体解析部第三課-第六班」',
  },
  {
    page: '25ページ',
    hints: [
      '先に28ページを開けましょう。',
      'うやむやになってしまったようですが、職員001はどんな話をしようとしていたのでしょうか？',
    ],
    answer: '内部記録検索「会議室」',
  },
  {
    page: '27ページ',
    hints: [
      '資料の続きは別にあるようです。',
      '26ページの最後の方に別資料の名称が書いてあるようですよ。',
    ],
    answer: '内部記録検索「血液・組織検査報告書」',
  },
  {
    page: '28ページ',
    hints: [
      '先に29ページを開けましょう。',
      'これは対策開発部に属するチームですね。このページは場所の名前でも引っかかるようです。',
    ],
    answer: '内部記録検索「特殊処理班」または「検査室」',
  },
  {
    page: '29ページ',
    hints: [
      '27ページの注意書きに何やら気になるワードが出てきましたね。',
      '血液検査はこれによって簡易的なものになったようです。',
    ],
    answer: '内部記録検索「事案001」',
  },
  {
    page: '30ページ',
    hints: [
      '25ページの会話中から見つけ出しましょう。',
      '場所の名前のようです。',
    ],
    answer: '内部記録検索「宿舎」',
  },
  {
    page: '31ページ',
    hints: [
      'この音声記録はどこの記録何でしょうか。',
      '記録場所をよく見て下さい。かなり具体的な場所が書いてありませんか？',
    ],
    answer: '内部記録検索「103号室」',
  },
  {
    page: 'EX1ページ',
    hints: [
      '5ページで深見先生が言っていた現象の名前は何でしょうか？彼の言う通り、自力で調べる必要がありそうです。',
      '”一度止まった植物の生長点が再活性化する現象”のようです。（漢字二字）',
    ],
    answer: '検索「貫生」',
  },
  {
    page: 'EX2ページ',
    hints: [
      'とある人物の娘さんの名前を調べてみましょう。',
      '12ページから推測できるはずですよ。',
    ],
    answer: '検索「深見恵理子」',
  },
  {
    page: 'EX3・EX4ページ',
    hints: [
      'そういえば、あのページにはどうして機構の記載がなかったのでしょうか？',
      '内部記録検索で彼の名前を検索してみましょう。',
    ],
    answer: '内部記録検索「物部庄太」',
  },

  // 以下40ページまで追加
];
---

<Layout title="ヒント | 愚者に芽吹きの言葉を">
  <main class="hint-page">

    <header class="hint-header">
      <p class="hint-label">HINT</p>
      <h1>ヒントページ</h1>
      <p>
        進行に行き詰まった際にご利用ください。<br />
        上から順番に確認することをおすすめします。
      </p>
    </header>

    <section class="hint-list">

      {pages.map((item) => (
        <details class="hint-page-item">

          <summary>
            <span class="arrow">▶</span>
            {item.page}
          </summary>

          <div class="hint-content">

            <details>
              <summary>ヒント1</summary>
              <p>{item.hints[0]}</p>
            </details>

            <details>
              <summary>ヒント2</summary>
              <p>{item.hints[1]}</p>
            </details>

            <details class="answer">
              <summary>答え</summary>
              <p>{item.answer}</p>
            </details>

          </div>

        </details>
      ))}

    </section>

  </main>
</Layout>

<style>
  .hint-page {
    width: min(1100px, calc(100% - 80px));
    margin: 0 auto;
    padding: 60px 0 100px;
    color: #333;
    line-height: 1.8;
  }

  .hint-header {
    margin-bottom: 35px;
  }

  .hint-label {
    margin: 0;
    color: #777;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
  }

  .hint-header h1 {
    margin: 4px 0 12px;
    font-size: 2.2rem;
  }

  .hint-header p {
    color: #666;
  }

  .hint-list {
    border-top: 1px solid #ccc;
  }

  .hint-page-item {
    border-bottom: 1px solid #ccc;
  }

  .hint-page-item > summary {
    padding: 18px 20px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
    background: #fafafa;
    list-style: none;
  }

  .hint-page-item > summary::-webkit-details-marker {
    display: none;
  }

  .hint-page-item > summary:hover {
    background: #f0f0f0;
  }

  .arrow {
    display: inline-block;
    width: 25px;
    color: #777;
  }

  .hint-page-item[open] > summary .arrow {
    transform: rotate(90deg);
  }

  .hint-content {
    padding: 10px 25px 25px 45px;
    background: #fff;
  }

  .hint-content details {
    margin: 10px 0;
    border: 1px solid #ddd;
    background: #fafafa;
  }

  .hint-content summary {
    padding: 12px 16px;
    cursor: pointer;
    font-weight: bold;
  }

  .hint-content p {
    margin: 0;
    padding: 12px 16px 15px;
    border-top: 1px solid #ddd;
  }

  .answer {
    margin-top: 18px !important;
    border-color: #da6464 !important;
  }

  .answer summary {
    background: #ffe3e3;
  }

  @media (max-width: 700px) {
    .hint-page {
      width: calc(100% - 30px);
      padding-top: 35px;
    }

    .hint-content {
      padding-left: 15px;
      padding-right: 15px;
    }
  }
</style>