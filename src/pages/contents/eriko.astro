---
import Layout from '../../layouts/Layout.astro';

const post = {
  user: '恵理子',
  date: '2018年7月',
  text: `このたび、結婚しました。

家族や友人、これまでお世話になったたくさんの方々に
見守っていただいて、今日の日を迎えることができました。

父さんが事故で亡くなってから5年。

結婚式の日には、お父さんの席に田本さんに
代わりに座っていただきました。

きっと父さんも、喜んでくれていると思います。

これからは二人で、ゆっくり歩いていけたらと思います。

みんな、本当にありがとう。`
};
---

<Layout title={`${post.user} | OUTSTAGRAM`}>
  <main class="outstagram">
    <header class="site-header">
      <a href="/ex/outstagram/">OUTSTAGRAM</a>
      <span>⌕　♡　☰</span>
    </header>

    <article class="post">
      <header class="post-header">
        <div class="avatar">恵</div>

        <div>
          <strong>{post.user}</strong>
          <small>@eriko_hukami</small>
        </div>

        <button>•••</button>
      </header>

      <div class="photo">
        <img src="/images/kekkon.webp" alt="結婚式の写真">
      </div>

      <div class="post-actions">
        <span>♡</span>
        <span>○</span>
        <span>↗</span>
        <span class="bookmark">♡</span>
      </div>

      <div class="likes">
        36 likes
      </div>

      <div class="caption">
        <strong>{post.user}</strong>
        <p>{post.text}</p>
      </div>

      <div class="comments">
        <p><strong>まい</strong> 結婚おめでとう！！🎉</p>
        <p><strong>タモト</strong> 本当におめでとうございます。</p>
        <p><strong>由美</strong> 恵理子おめでとう！素敵な式だった🥲</p>
      </div>

      <time>{post.date}</time>
    </article>
  </main>
</Layout>

<style>
  .outstagram {
    min-height: 100vh;
    background: #fafafa;
    color: #222;
    font-family: Arial, Helvetica, sans-serif;
  }

  .site-header {
    height: 60px;
    border-bottom: 1px solid #ddd;
    background: white;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 24px;
    box-sizing: border-box;
  }

  .site-header a {
    color: #222;
    text-decoration: none;
    font-family: Georgia, serif;
    font-size: 24px;
    font-weight: bold;
  }

  .post {
    width: min(100%, 600px);
    margin: 30px auto;
    background: white;
    border: 1px solid #ddd;
  }

  .post-header {
    height: 62px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ddd;

    display: grid;
    place-items: center;

    font-weight: bold;
  }

  .post-header strong,
  .post-header small {
    display: block;
  }

  .post-header small {
    margin-top: 2px;
    color: #888;
    font-size: 11px;
  }

  .post-header button {
    margin-left: auto;
    border: 0;
    background: none;
    font-size: 18px;
  }

  .photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #eee;  
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .post-actions {
    display: flex;
    gap: 18px;
    padding: 12px 16px 4px;
    font-size: 24px;
  }

  .bookmark {
    margin-left: auto;
  }

  .likes,
  .caption,
  .comments,
  time {
    display: block;
    padding-left: 16px;
    padding-right: 16px;
  }

  .likes {
    font-weight: bold;
    font-size: 14px;
    margin-top: 4px;
  }

  .caption {
    margin-top: 10px;
    line-height: 1.8;
    font-size: 14px;
  }

  .caption p {
    white-space: pre-line;
    margin: 4px 0;
  }

  .comments {
    margin-top: 16px;
    color: #555;
    font-size: 13px;
  }

  .comments p {
    margin: 7px 0;
  }

  time {
    display: block;
    margin: 18px 0;
    padding-bottom: 18px;
    color: #999;
    font-size: 11px;
  }

  @media (max-width: 600px) {
    .post {
      margin: 0;
      border-left: 0;
      border-right: 0;
    }
  }
</style>