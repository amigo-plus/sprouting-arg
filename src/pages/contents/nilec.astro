---
import Layout from '../../layouts/Layout.astro';

const nav = ['トップ', '機構について', '事業内容', 'ニュース', '提携・協力', 'お問い合わせ'];

const news = [
  { date: '2024/06/03', text: '令和6年度 外来生物防除事業の実施状況を公表しました。' },
  { date: '2024/02/14', text: '絶滅危惧種保護に関する報告書(PDF)を掲載しました。' },
  { date: '2023/11/20', text: '張岡大学理学部との共同調査事業について、成果概要を公開しました。' },
  { date: '2023/05/09', text: '環境省との連携事業に関する説明会を開催しました。' },
];

const partners = [
  '陵水大学 農学研究科',
  '西海道大学 環境科学部',
  '環境省 自然環境局',
  '各都道府県 環境保全担当部局',
];
---

<Layout title="国立研究開発法人 日本生命生態保全機構(NILEC)">
  <div class="nilec">

    <!-- 上部バー -->
    <div class="topbar">
      <div class="container topbar-inner">
        <span>国立研究開発法人 日本生命生態保全機構</span>

        <a href="/contents/nilec-login">
          職員の方はこちら
        </a>
      </div>
    </div>

    <!-- ヘッダー -->
    <header class="header">
      <div class="container header-inner">

        <div class="logo-mark">
          <span>N</span>
        </div>

        <div class="logo-text">
          <h1>国立研究開発法人<br />日本生命生態保全機構</h1>
          <p>NATIONAL INSTITUTE FOR LIFE AND ECOLOGICAL CONSERVATION</p>
        </div>

      </div>
    </header>

    <!-- ナビ -->
    <nav class="nav">
      <div class="container nav-inner">
        {nav.map((n, index) => (
          <a
            href="#"
            onclick="return false;"
            class={index === 0 ? 'current' : ''}
          >
            {n}
          </a>
        ))}
      </div>
    </nav>

    <!-- メイン -->
    <main>

      <!-- メインビジュアル -->
      <section class="hero">

        <!--
          ここを好きな画像に変更
          例：/images/nature.jpg
        -->
        <img
          src="/images/nature.jpg"
          alt=""
          class="hero-image"
        />

        <div class="hero-overlay"></div>

        <div class="container hero-content">
          <p class="hero-label">
            LIFE & ECOLOGICAL CONSERVATION
          </p>

          <h2>
            生命と生態系の<br />
            未来を守る。
          </h2>

          <p class="hero-text">
            日本の豊かな自然環境を次世代へつなぐため、
            調査・研究・保全活動を行っています。
          </p>
        </div>

      </section>

      <!-- 機構概要 -->
      <section class="intro">
        <div class="container">

          <div class="section-heading">
            <span>ABOUT NILEC</span>
            <h2>日本の生命と生態系を守る</h2>
          </div>

          <p class="intro-text">
            当機構は、国内の生態系保全、特定外来生物の防除・調査、
            絶滅危惧種の保護・繁殖支援を目的として設立された
            国立研究開発法人です。
            環境省をはじめとする関係省庁、および全国の大学・研究機関と連携し、
            自然環境の保全に取り組んでいます。
          </p>

        </div>
      </section>

      <!-- 事業内容 -->
      <section class="business">
        <div class="container">

          <div class="section-heading">
            <span>OUR ACTIVITIES</span>
            <h2>事業内容</h2>
          </div>

          <div class="business-grid">

            <article class="business-card">
              <div class="card-number">01</div>
              <h3>生態系調査</h3>
              <p>
                国内各地域における生態系の状態を調査・モニタリングし、
                長期的な環境変化を記録しています。
              </p>
            </article>

            <article class="business-card">
              <div class="card-number">02</div>
              <h3>外来生物対策</h3>
              <p>
                特定外来生物の分布調査および防除に関する
                技術支援・研究を行っています。
              </p>
            </article>

            <article class="business-card">
              <div class="card-number">03</div>
              <h3>希少種保全</h3>
              <p>
                絶滅危惧種の生息状況を調査し、
                保護・繁殖に関する研究を進めています。
              </p>
            </article>

            <article class="business-card">
              <div class="card-number">04</div>
              <h3>共同研究</h3>
              <p>
                大学・研究機関・自治体等と連携し、
                国内の自然環境に関する研究を行っています。
              </p>
            </article>

          </div>

        </div>
      </section>

      <!-- 自然画像＋説明 -->
      <section class="field">

        <div class="field-image">
          <img
            src="/images/nature-forest.jpg"
            alt="森林の風景"
          />
        </div>

        <div class="field-text">
          <span>FIELD RESEARCH</span>
          <h2>現地から、未来を考える。</h2>

          <p>
            私たちは研究室だけでなく、全国各地の山岳地域、
            森林、河川、湿地などを実際に訪れ、
            現地調査を行っています。
          </p>

          <a href="#" onclick="return false;">
            調査・研究について →
          </a>
        </div>

      </section>

      <!-- お知らせ -->
      <section class="news-section">
        <div class="container">

          <div class="section-heading">
            <span>NEWS</span>
            <h2>お知らせ</h2>
          </div>

          <ul class="news-list">
            {news.map((n) => (
              <li>
                <time>{n.date}</time>
                <a href="#" onclick="return false;">
                  {n.text}
                </a>
              </li>
            ))}
          </ul>

          <div class="more">
            <a href="#" onclick="return false;">
              お知らせ一覧 →
            </a>
          </div>

        </div>
      </section>

      <!-- 提携機関 -->
      <section class="partners">
        <div class="container">

          <div class="section-heading">
            <span>PARTNERS</span>
            <h2>提携・協力機関</h2>
          </div>

          <ul>
            {partners.map((p) => (
              <li>{p}</li>
            ))}
          </ul>

        </div>
      </section>

    </main>

    <!-- フッター -->
    <footer class="footer">
      <div class="container">

        <div class="footer-title">
          <strong>国立研究開発法人 日本生命生態保全機構</strong>
          <span>NILEC</span>
        </div>

        <p>
          National Institute for Life and Ecological Conservation
        </p>

        <div class="footer-bottom">
          <span>© National Institute for Life and Ecological Conservation</span>
          <span>このWebサイトの内容はすべてフィクションです。</span>
        </div>

      </div>
    </footer>

  </div>
</Layout>

<style is:global>

  .nilec {
    --green: #176b4d;
    --dark-green: #0d4432;
    --navy: #193746;
    --light-green: #edf4f0;
    --line: #d7dfdb;

    color: #26312d;
    background: #fff;
    min-height: 100vh;
    font-family:
      "Noto Sans JP",
      "Yu Gothic",
      "Hiragino Kaku Gothic ProN",
      Meiryo,
      sans-serif;
    line-height: 1.8;
  }

  .container {
    width: min(1180px, calc(100% - 64px));
    margin: 0 auto;
  }


  /* =========================
     TOP BAR
  ========================= */

  .topbar {
    background: #123c32;
    color: #d8e6e0;
    font-size: 12px;
  }

  .topbar-inner {
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar a {
    color: #fff;
    text-decoration: none;
    border-left: 1px solid rgba(255,255,255,.25);
    padding-left: 18px;
  }

  .topbar a:hover {
    text-decoration: underline;
  }


  /* =========================
     HEADER
  ========================= */

  .header {
    background: #fff;
    border-bottom: 1px solid #dce4e0;
  }

  .header-inner {
    min-height: 92px;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .logo-mark {
    width: 58px;
    height: 58px;
    border: 3px solid var(--green);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--green);
    font-family: Georgia, serif;
    font-size: 25px;
    font-weight: bold;
  }

  .logo-text h1 {
    color: var(--navy);
    font-size: 19px;
    line-height: 1.45;
    margin: 0;
    letter-spacing: .03em;
  }

  .logo-text p {
    color: #71817a;
    font-size: 9px;
    letter-spacing: .16em;
    margin: 4px 0 0;
  }


  /* =========================
     NAV
  ========================= */

  .nav {
    background: var(--navy);
  }

  .nav-inner {
    display: flex;
  }

  .nav a {
    color: #dce8e5;
    text-decoration: none;
    padding: 12px 28px;
    font-size: 13px;
    border-right: 1px solid rgba(255,255,255,.1);
    transition: background .15s;
  }

  .nav a:hover {
    background: #275262;
  }

  .nav a.current {
    background: var(--green);
    color: #fff;
  }


  /* =========================
     HERO
  ========================= */

  .hero {
    height: 440px;
    position: relative;
    overflow: hidden;
    color: #fff;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(5, 31, 25, .78) 0%,
        rgba(5, 31, 25, .4) 45%,
        rgba(5, 31, 25, .08) 100%
      );
  }

  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-label {
    font-size: 11px;
    letter-spacing: .2em;
    margin: 0 0 10px;
    color: #c8ded4;
  }

  .hero h2 {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.35;
    letter-spacing: .04em;
    margin: 0 0 18px;
    font-weight: 500;
  }

  .hero-text {
    max-width: 560px;
    margin: 0;
    font-size: 15px;
    color: #edf5f1;
  }


  /* =========================
     SECTION HEADING
  ========================= */

  .section-heading {
    margin-bottom: 28px;
  }

  .section-heading span {
    color: var(--green);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: .2em;
  }

  .section-heading h2 {
    color: var(--navy);
    font-size: 27px;
    margin: 2px 0 0;
    letter-spacing: .04em;
  }


  /* =========================
     INTRO
  ========================= */

  .intro {
    padding: 70px 0;
  }

  .intro-text {
    max-width: 850px;
    font-size: 15px;
    color: #4e5c56;
    margin: 0;
  }


  /* =========================
     BUSINESS
  ========================= */

  .business {
    background: #f1f5f3;
    padding: 65px 0 75px;
  }

  .business-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .business-card {
    background: #fff;
    padding: 28px 25px 30px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    min-height: 220px;
  }

  .card-number {
    color: var(--green);
    font-family: Georgia, serif;
    font-size: 25px;
    margin-bottom: 15px;
  }

  .business-card h3 {
    color: var(--navy);
    font-size: 17px;
    margin: 0 0 10px;
  }

  .business-card p {
    color: #66736d;
    font-size: 13px;
    margin: 0;
  }


  /* =========================
     FIELD
  ========================= */

  .field {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 420px;
  }

  .field-image {
    overflow: hidden;
  }

  .field-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .field-text {
    padding: 65px max(40px, 7vw);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--dark-green);
    color: #fff;
  }

  .field-text > span {
    font-size: 10px;
    letter-spacing: .2em;
    color: #a9c9bc;
  }

  .field-text h2 {
    font-size: 29px;
    font-weight: 500;
    margin: 8px 0 20px;
  }

  .field-text p {
    max-width: 500px;
    color: #d6e4df;
    font-size: 14px;
  }

  .field-text a {
    margin-top: 18px;
    color: #fff;
    font-size: 13px;
    text-decoration: none;
  }

  .field-text a:hover {
    text-decoration: underline;
  }


  /* =========================
     NEWS
  ========================= */

  .news-section {
    padding: 70px 0;
  }

  .news-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .news-list li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    padding: 14px 5px;
    border-bottom: 1px dotted #cdd6d2;
    font-size: 13px;
  }

  .news-list time {
    color: #71817a;
  }

  .news-list a {
    color: #30443c;
    text-decoration: none;
  }

  .news-list a:hover {
    text-decoration: underline;
  }

  .more {
    margin-top: 18px;
    text-align: right;
  }

  .more a {
    color: var(--green);
    font-size: 13px;
  }


  /* =========================
     PARTNERS
  ========================= */

  .partners {
    background: #f5f7f6;
    padding: 60px 0 70px;
  }

  .partners ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .partners li {
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    color: #4f5d57;
    font-size: 13px;
  }

  .partners li::before {
    content: "›";
    color: var(--green);
    margin-right: 10px;
  }


  /* =========================
     FOOTER
  ========================= */

  .footer {
    background: #16362e;
    color: #c9d8d2;
    padding: 30px 0 22px;
  }

  .footer-title {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  .footer-title strong {
    color: #fff;
    font-size: 14px;
  }

  .footer-title span {
    font-family: Georgia, serif;
    color: #9ebcaf;
    font-size: 13px;
  }

  .footer p {
    color: #8fa69c;
    font-size: 10px;
    letter-spacing: .08em;
    margin: 5px 0 25px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 15px;
    border-top: 1px solid rgba(255,255,255,.12);
    color: #81968e;
    font-size: 10px;
  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 800px) {

    .container {
      width: calc(100% - 32px);
    }

    .nav-inner {
      overflow-x: auto;
    }

    .nav a {
      padding: 11px 18px;
      white-space: nowrap;
    }

    .hero {
      height: 400px;
    }

    .business-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .field {
      grid-template-columns: 1fr;
    }

    .field-image {
      height: 300px;
    }

    .partners ul {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 600px) {

    .header-inner {
      min-height: 78px;
    }

    .logo-mark {
      width: 45px;
      height: 45px;
      font-size: 20px;
    }

    .logo-text h1 {
      font-size: 14px;
    }

    .logo-text p {
      display: none;
    }

    .hero {
      height: 350px;
    }

    .hero h2 {
      font-size: 32px;
    }

    .business-grid {
      grid-template-columns: 1fr;
    }

    .news-list li {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 5px;
    }
  }

</style>