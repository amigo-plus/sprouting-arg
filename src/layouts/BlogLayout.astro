---
// 配置先: src/layouts/BlogLayout.astro
import Layout from './Layout.astro';
import { BLOG_TITLE, BLOG_BASE, profile } from '../data/blogPosts';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Layout title={title}>
  <div class="bl">
    <header class="bl-header">
      <a href={`${BLOG_BASE}/`} class="bl-title">{BLOG_TITLE}</a>
      <div class="bl-tagline">庭いじりと山歩きの記録</div>
    </header>

    <div class="bl-wrap">
      <main class="bl-main">
        <slot />
      </main>

      <aside class="bl-side">
        <div class="bl-avatar">
          <img src={profile.avatar} alt="" onerror="this.style.display='none'" />
        </div>
        <div class="bl-hn">{profile.name}</div>
        <p class="bl-profile">{profile.text}</p>
      </aside>
    </div>

    <footer class="bl-footer">
      <p>このWebサイトの内容はすべてフィクションであり、実在の人物・団体とは一切関係がありません。</p>
    </footer>
  </div>
</Layout>

<style is:global>
  .bl { background: #f4f7ef; color: #2f3a2c; min-height: 100vh; display: flex; flex-direction: column; font-size: 15px; line-height: 1.8; }
  .bl-header { background: #e3ecd6; border-bottom: 3px solid #8fae6e; padding: 22px 24px 14px; }
  .bl-title { display: block; max-width: 960px; margin: 0 auto; font-size: 1.7rem; font-weight: bold; color: #46603a; text-decoration: none; }
  .bl-tagline { max-width: 960px; margin: 2px auto 0; font-size: 0.8rem; color: #6b7d5e; }

  .bl-wrap { flex: 1; width: 100%; max-width: 960px; margin: 24px auto; padding: 0 24px; box-sizing: border-box; display: flex; gap: 32px; align-items: flex-start; }
  .bl-main { flex: 1; min-width: 0; background: #fff; border: 1px solid #d5dfc8; border-radius: 6px; padding: 24px 28px; }

  .bl-side { width: 230px; flex-shrink: 0; background: #fff; border: 1px solid #d5dfc8; border-radius: 6px; padding: 24px 20px; text-align: center; }
  .bl-avatar { width: 140px; height: 140px; border-radius: 50%; background: #d5dfc8; margin: 0 auto 14px; overflow: hidden; }
  .bl-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bl-hn { font-weight: bold; font-size: 1.05rem; margin-bottom: 8px; }
  .bl-profile { font-size: 0.85rem; text-align: center; color: #55634c; margin: 0; white-space: pre-line; }

  .bl-footer { text-align: center; font-size: 12px; color: #70757a; background: #e9efe0; border-top: 1px solid #d5dfc8; padding: 16px; }
  .bl-footer p { margin: 2px 0; }

  .bl-main a { color: #3f6d2a; }

  @media (max-width: 720px) {
    .bl-wrap { flex-direction: column-reverse; padding: 0 16px; }
    .bl-side { width: 100%; box-sizing: border-box; }
    .bl-main { width: 100%; box-sizing: border-box; padding: 18px; }
  }
</style>