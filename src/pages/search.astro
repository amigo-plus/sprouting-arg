---
import Layout from '../layouts/Layout.astro';
---

<Layout title="検索結果">
  <div class="bing-search-page">
    <header class="b-header">
      <a href="/" class="b-logo-text">S</a>
      <form id="searchForm" class="b-search-form">
        <input type="text" id="mainSearchInput" class="b-input" placeholder="検索キーワードを入力..." />
        <button type="submit" class="b-btn">検索</button>
      </form>
    </header>

    <!-- タブ -->
    <nav class="b-nav">
      <span class="active">すべて</span>
      <span>画像</span>
      <span>動画</span>
      <span>ニュース</span>
      <span>地図</span>
    </nav>

    <!-- メインコンテンツ -->
    <div class="b-body">
      <main class="b-main" id="resultArea"></main>
      <aside class="b-sidebar" id="sidebarArea"></aside>
    </div>

    <!-- フッター -->
    <footer class="b-footer">
      <p>このWebサイトの内容はすべてフィクションであり、実在の人物・団体とは一切関係がありません。</p>
    </footer>
  </div>
</Layout>

<script>
  async function loadDB() {
    const res = await fetch(`${import.meta.env.BASE_URL}data/searchDatabase.json`);
    return res.json();
  }

  function getQuery() {
    return new URLSearchParams(window.location.search).get('q') || '';
  }

  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (m) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m] as string));
  }

  async function render() {
    const query = getQuery().trim();
    const input = document.getElementById('mainSearchInput') as HTMLInputElement;
    if (input) input.value = query;

    const resultArea = document.getElementById('resultArea')!;
    const sidebarArea = document.getElementById('sidebarArea')!;

    // 1. 未入力の場合
    if (!query) {
      resultArea.innerHTML = `<div class="b-card"><p style="color:#5f6368; margin:0;">キーワードを入力して検索してください。</p></div>`;
      sidebarArea.innerHTML = '';
      return;
    }

    const db = await loadDB();
    const entry = db[query];
    // 旧形式(配列だけ)の場合にも動くようにしてある
    const results = Array.isArray(entry) ? entry : (entry?.results ?? []);
    const count = Array.isArray(entry) ? results.length * 1280 : (entry?.count ?? results.length);

    if (results.length === 0) {
      resultArea.innerHTML = `
        <div class="b-card">
          <p class="b-not-found-text">「<strong>${escapeHtml(query)}</strong>」に一致する情報は見つかりませんでした。</p>
          <ul class="b-not-found-hints">
            <li>キーワードに誤字や脱字がないか確認してください。</li>
          </ul>
        </div>`;
    } else {
      resultArea.innerHTML = `
        <p class="b-count">約 ${count.toLocaleString()} 件のサイト</p>
        ${results.map((item: any) => `
          <article class="b-card">
            <div class="b-card-url">${escapeHtml(item.displayUrl ?? item.url)}</div>
            <h2 class="b-card-title"><a href="${item.url}">${escapeHtml(item.title)}</a></h2>
            <p class="b-card-snippet">${escapeHtml(item.snippet)}</p>
          </article>
        `).join('')}`;
    }

    // 3. サイドバーエリアの動的生成 (SVGアイコン付き)
    if (query === "真蔓") {
      const iconSvg = `<svg class="b-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`;
      const safeQuery = escapeHtml(query);

      sidebarArea.innerHTML = `
        <h4>${safeQuery} について掘り下げる</h4>
        <div class="b-side-item">${iconSvg}<span>${safeQuery} 市役所 ホームページ</span></div>
        <div class="b-side-item">${iconSvg}<span>${safeQuery} 市 地図</span></div>
        <div class="b-side-item">${iconSvg}<span>${safeQuery} 市 人口</span></div>
        <div class="b-side-item">${iconSvg}<span>${safeQuery} 市 天気</span></div>
      `;
    } else {
      sidebarArea.innerHTML = "";
    }
  }

  document.getElementById('searchForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('mainSearchInput') as HTMLInputElement;
    const q = input.value.trim();
    const url = new URL(window.location.href);
    url.searchParams.set('q', q);
    window.location.href = url.toString();
  });

  render();
</script>

<style is:global>
  .bing-search-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #fff !important;
  }

  /* ヘッダー */
  .b-header {
    display: flex;
    align-items: center;
    padding: 16px 24px;
    gap: 20px;
    background: #fff;
  }

  /* 文字ロゴ「S」 */
  .b-logo-text {
    font-size: 28px;
    font-weight: 900;
    color: #0078d4;
    text-decoration: none;
    font-family: Arial, sans-serif;
    line-height: 1;
    padding: 0 4px;
  }

  .b-search-form {
    display: flex;
    align-items: center;
    border: 1px solid #0078d4;
    border-radius: 24px;
    padding: 4px 6px 4px 16px;
    width: 100%;
    max-width: 560px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  }

  .b-input {
    flex: 1;
    border: none !important;
    outline: none !important;
    font-size: 15px;
    background: transparent;
  }

  .b-btn {
    background: #0078d4;
    color: #fff;
    border: none;
    padding: 8px 20px;
    border-radius: 18px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
  }

  .b-nav {
    display: flex;
    gap: 24px;
    padding: 0 24px 12px 68px;
    border-bottom: 1px solid #e0e0e0;
    font-size: 14px;
    color: #666;
  }

  .b-nav .active {
    color: #0078d4;
    font-weight: bold;
    border-bottom: 2px solid #0078d4;
    padding-bottom: 10px;
  }

  .b-body {
    flex: 1;
    display: flex;
    max-width: 1150px;
    width: 100%;
    margin: 24px auto;
    padding: 0 24px;
    box-sizing: border-box;
    gap: 48px;
  }

  .b-main { flex: 1; }
  .b-count { font-size: 13px; color: #666; margin-bottom: 16px; margin: 0 0 20px; }

  .b-card {
    background: #fff;
    padding: 0; 
    margin-bottom: 20px;
  }

  .b-card-url { font-size: 12px; color: #444; margin-bottom: 2px; margin: 0 0 2px;}
  .b-card-title { margin: 0; line-height: 1.3; }
  .b-card-title a { color: #1a0dab; text-decoration: none; font-size: 18px; font-weight: 500; }
  .b-card-title a:hover { text-decoration: underline; }
  .b-card-snippet { font-size: 13px; color: #3c4043; margin-top: 6px; margin: 4px 0 0; line-height: 1.5; }

  /* ヒットしなかった場合のテキスト */
  .b-not-found-text {
    font-size: 15px;
    color: #202124;
    margin: 0 0 12px 0;
  }

  .b-not-found-hints {
    font-size: 13px;
    color: #5f6368;
    padding-left: 20px;
    margin: 0;
    line-height: 1.6;
  }

  /* サイドバー */
  .b-sidebar { width: 300px; }
  .b-sidebar h4 { font-size: 15px; margin-bottom: 16px; color: #202124; }
  
  .b-side-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #e0e0e0;
    padding: 10px 16px;
    border-radius: 20px;
    margin-bottom: 10px;
    font-size: 13px;
    color: #333;
    cursor: pointer;
  }

  .b-side-icon {
    width: 16px;
    height: 16px;
    stroke: #0078d4;
  }

  .b-footer {
    width: 100%;
    padding: 20px;
    text-align: center;
    font-size: 12px;
    color: #70757a;
    background-color: #f2f2f2;
    border-top: 1px solid #e4e4e4;
    margin-top: auto;
  }
  .b-footer p { margin: 2px 0; }
</style>